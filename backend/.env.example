# Striply Backend Environment Configuration
NODE_ENV=development
PORT=5000

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Client CORS Origins (Comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:19006

# Twilio / Gupshup WhatsApp Credentials (Optional for local testing)
WHATSAPP_ENABLED=true
WHATSAPP_API_KEY=dummy_key

